# ─── Canonicalise www → apex, puis force HTTPS ──────────────────────────────
RewriteEngine On

# 1. Redirect www to apex (chef-knife.pk is the canonical URL)
RewriteCond %{HTTP_HOST} ^www\.chef-knife\.pk$ [NC]
RewriteRule (.*) https://chef-knife.pk/$1 [R=301,L]

# 2. Force HTTPS (OVH mutualisé — X-Forwarded-Proto method)
RewriteCond %{HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── Block direct access to PHP secrets ──────────────────────────────────────
<FilesMatch "^secrets\.php$">
    Require all denied
</FilesMatch>
