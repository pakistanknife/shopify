# ─── Force HTTPS (OVH reverse-proxy compatible) ─────────────────────────────
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Fallback: also check HTTPS var directly (works on some OVH configs)
RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── Block direct access to PHP secrets ──────────────────────────────────────
<FilesMatch "^secrets\.php$">
    Require all denied
</FilesMatch>
