# ─── Force HTTPS — syntaxe recommandée OVH mutualisé ────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── Block direct access to PHP secrets ──────────────────────────────────────
<FilesMatch "^secrets\.php$">
    Require all denied
</FilesMatch>
