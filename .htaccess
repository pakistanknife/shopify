# ─── Force HTTPS (www.chef-knife.pk is canonical — apex SSL pending) ─────────
RewriteEngine On

# Force HTTPS (OVH mutualisé — X-Forwarded-Proto method)
# NOTE: www→apex redirect is intentionally disabled until an SSL cert is
# generated for the apex domain (chef-knife.pk) in OVH Manager.
RewriteCond %{HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── Block direct access to PHP secrets ──────────────────────────────────────
<FilesMatch "^secrets\.php$">
    Require all denied
</FilesMatch>
